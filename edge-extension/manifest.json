{
  "manifest_version": 3,
  "name": "英语学习助手",
  "version": "1.7.3",
  "description": "选中文字后使用本地美式男声朗读，或通过本机 Codex 进行英汉互译。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43128/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
